# Copia este archivo a .env y ajusta los valores. .env NO se sube al repositorio.
# Lo leen docker-compose y el perfil dev de Spring (spring.config.import).

# --- PostgreSQL ---
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambia-esta-clave
# Cambia el puerto si ya tienes otro PostgreSQL usando el 5432.
POSTGRES_PORT=5432

# --- JWT ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-bytes
JWT_EXPIRACION=1h

# --- Administrador inicial (opcional) ---
# Si ambas están definidas y el usuario no existe, se crea al arrancar.
ADMIN_EMAIL=admin@reservas.local
ADMIN_PASSWORD=cambia-esta-clave-admin
ADMIN_NOMBRE=Administrador

# --- Correo ---
# En dev, Mailpit (docker compose up -d mailpit): SMTP en 1025, bandeja en http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
# Para un SMTP real: MAIL_USERNAME, MAIL_PASSWORD, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true, MAIL_PORT=587
NOTIFICACIONES_HABILITADAS=true
NOTIFICACIONES_URL_BASE=http://localhost:8080
